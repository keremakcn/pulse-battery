<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pulse · Pil widget’ı" Width="372" Height="590" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="#EFF4F2">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#82938F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="8,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#263832"/><Setter Property="Foreground" Value="#B9F9DA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#879B93"/><Setter Property="FontSize" Value="11"/></Style>
 </Window.Resources>
 <Border Margin="6" CornerRadius="22" Background="#111B18" BorderBrush="#31433A" BorderThickness="1">
  <Grid Margin="23,18,23,18">
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="28"/><RowDefinition Height="84"/><RowDefinition Height="38"/><RowDefinition Height="20"/><RowDefinition Height="136"/><RowDefinition Height="16"/><RowDefinition Height="83"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="DragArea" Background="Transparent"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#B8F4CC" Margin="0,0,9,0"/><TextBlock Text="pulse" FontSize="20" FontWeight="SemiBold"/><TextBlock Text=" /  PİL" FontSize="9" Foreground="#72877C" Margin="9,9,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Pin" Content="◇" ToolTip="Her zaman üstte"/><Button x:Name="Hide" Content="−" ToolTip="Sistem tepsisine küçült"/><Button x:Name="Quit" Content="×" ToolTip="Kapat"/></StackPanel></Grid>
   <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom"><TextBlock x:Name="Status" Text="PİL OKUNUYOR" FontSize="10" Foreground="#B8F4CC"/><TextBlock x:Name="DemoLabel" FontSize="10" Foreground="#E7BB78" Margin="10,0,0,0"/></StackPanel>
   <Grid Grid.Row="2"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="Percent" Text="—" FontSize="62" FontWeight="Light"/><TextBlock Text="%" FontSize="23" Foreground="#829B8E" VerticalAlignment="Bottom" Margin="4,0,0,13"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="Eta" Text="— dk" FontSize="21" FontWeight="Light" HorizontalAlignment="Right"/><TextBlock x:Name="EtaCaption" Text="tahmini kalan süre" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel></Grid>
   <StackPanel Grid.Row="3"><Border Height="5" Background="#283A30" CornerRadius="2"><Grid><Border x:Name="BatteryFill" Background="#B8F4CC" CornerRadius="2" HorizontalAlignment="Left" Width="0"/></Grid></Border><TextBlock x:Name="EstimateNote" Text="Ölçümler bekleniyor" Style="{StaticResource Muted}" Margin="0,9,0,0" FontSize="10"/></StackPanel>
   <Border Grid.Row="5" Background="#192720" CornerRadius="14" BorderBrush="#2C4033" BorderThickness="1"><Grid Margin="15,12"><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="37"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="RateLabel" Text="ANLIK TÜKETİM" FontSize="10" Foreground="#9EBAA9"/><TextBlock x:Name="Average" Text="1 dk ort. — W" Style="{StaticResource Muted}" HorizontalAlignment="Right"/><StackPanel Grid.Row="1" Orientation="Horizontal"><TextBlock x:Name="Rate" Text="—" FontSize="30" FontWeight="Light"/><TextBlock Text="W" FontSize="15" Foreground="#99B5A4" VerticalAlignment="Bottom" Margin="5,0,0,6"/></StackPanel><Canvas x:Name="Chart" Grid.Row="2" ClipToBounds="True" Margin="0,6,0,0"/><TextBlock x:Name="ChartNote" Grid.Row="2" Text="Veri bekleniyor" FontSize="10" Foreground="#769481" VerticalAlignment="Bottom" HorizontalAlignment="Right"/></Grid></Border>
   <Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ŞU AN / TAM DOLUM" Style="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="Capacity" Text="— / — Wh" FontSize="17" Margin="0,6,0,0"/><TextBlock x:Name="Voltage" Text="Voltaj bilgisi bekleniyor" FontSize="10" Foreground="#71867B" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="PİL SAĞLIĞI" Style="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Right"/><TextBlock x:Name="Health" Text="—" FontSize="17" Margin="0,6,0,0" HorizontalAlignment="Right"/><TextBlock x:Name="Design" Text="Tasarım kapasitesi: —" FontSize="10" Foreground="#71867B" Margin="0,7,0,0" HorizontalAlignment="Right"/></StackPanel></Grid>
   <StackPanel Grid.Row="8" VerticalAlignment="Bottom"><Button x:Name="Analyze" Content="Pil geçmişimi analiz et" Background="#22392C" Foreground="#B8F4CC" HorizontalContentAlignment="Left" FontSize="11" Padding="10,6" Margin="0,0,0,5" ToolTip="Windows kayıtlarını cihazında analiz eder. Pili zorlayan bir test yapmaz; hiçbir veri göndermez."/><TextBlock x:Name="HistoryStatus" Text="İlk tahmini Windows geçmişinle başlat" FontSize="9" Foreground="#879B93" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NormalUse" Text="Genel kullanım profili öğreniliyor" FontSize="10" Foreground="#9EBAA9" Margin="0,0,0,9"/><Grid><TextBlock x:Name="Footer" Text="●  Canlı · 5 sn aralıkla" FontSize="10" Foreground="#71867B"/><TextBlock Text="az yer. net bilgi." FontSize="10" Foreground="#52695C" HorizontalAlignment="Right"/></Grid></StackPanel>
  </Grid>
 </Border>
</Window>
